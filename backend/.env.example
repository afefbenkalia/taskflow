DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/taskflow_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/taskflow_test
JWT_SECRET_KEY=change_me_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# Leave SMTP_HOST empty in development: emails (reset links) are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=change_me
SMTP_FROM=TaskFlow <no-reply@taskflow.local>
SMTP_STARTTLS=true
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
