# ============================================
#  Variables d'environnement (secrets)
# ============================================
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Clés privées et certificats (ne jamais publier)
*.pem
*.key
*.p12
*.pfx

# ============================================
#  Backend — Python / FastAPI
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Environnements virtuels
venv/
.venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Tests et couverture
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Outils de qualité
.mypy_cache/
.ruff_cache/
.pyre/
.dmypy.json

# Base de données locale (SQLite de dev/test) et sauvegardes (peuvent contenir des données réelles)
*.db
*.sqlite
*.sqlite3
backend/test.db
*.dump
*.bak

# Fichiers déposés dans les projets (UPLOAD_DIR)
backend/storage/

# ============================================
#  Frontend — React / Vite / Node
# ============================================
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local
.vite/

# Logs npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# TypeScript et caches d'outils
*.tsbuildinfo
.eslintcache
.cache/

# ============================================
#  Docker
# ============================================
docker-compose.override.yml
postgres-data/
pgdata/

# ============================================
#  Logs et fichiers temporaires
# ============================================
logs/
*.log
tmp/
temp/

# ============================================
#  Éditeurs / IDE
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Réglages locaux de Claude Code (chemins et permissions propres à chaque poste)
.claude/

# ============================================
#  Systèmes d'exploitation
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
#  Livrable final
# ============================================
*.zip